PORT=3000
DB_PATH=./data/moravec.sqlite

# Required in production (NODE_ENV=production) — a long random string used to
# salt the email hash that identifies a User. Never committed, never plaintext.
HASH_SECRET=

# Optional. Without it, email delivery is skipped, with no recipient or code
# in logs. Set a test key to exercise email delivery locally.
RESEND_API_KEY=

# Optional. Defaults to allowing any origin (auth is per-request Bearer
# tokens, not cookies, so this carries no CSRF risk). Set to the frontend's
# origin to tighten it once that's fixed.
CORS_ORIGIN=

OTP_IP_RATE_LIMIT_MAX=10
OTP_IP_RATE_LIMIT_WINDOW_MS=600000
OTP_GLOBAL_RATE_LIMIT_MAX=100
OTP_GLOBAL_RATE_LIMIT_WINDOW_MS=3600000
TRUSTED_PROXY_IP=
