{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --conditions development src/server.ts",
    "build": "tsc -p tsconfig.build.json",
