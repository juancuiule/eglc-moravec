  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "engine": "workspace:*",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  }
}
